#!/bin/sh
# Refuses a commit that changes how a faction's cards play (cost, stats, keywords, effects) unless that faction passes
# tools/design_gate.py. Text, hover links, art and champion marks don't count (tools/hooks/gameplay_changed.js).
# Turned on at the start of every chat: git config core.hooksPath tools/hooks (CLAUDE.md). Never commit with --no-verify.
cd "$(git rev-parse --show-toplevel)" || exit 1
git diff --cached --name-only | grep -q '^src/game/js/cards/' || exit 0
letters=$(node tools/hooks/gameplay_changed.js)
[ -z "$letters" ] && exit 0
python3 tools/build.py >/dev/null || exit 1
for f in $letters; do
  python3 tools/design_gate.py "$f" || { echo "design gate: faction $f fails; commit refused. Tell Kaptain if this blocks unrelated work."; exit 1; }
done
