{"game": "stormbound", "ext_id": "glossary:Poison", "name": "Poison", "category": "keyword", "source_type": "status (Stormbound Kitty rulebook glossary (https://stormbound-kitty.com/rulebook), supplement)", "edition": null, "faction": null, "subtypes": null, "rarity": null, "cost": null, "cost_num": null, "stats": null, "text": "A poisoned unit takes 1 damage at the start of each turn until it dies or is vitalized.", "extra": null, "variants": null, "id": 1000043}
{"game": "stormbound", "ext_id": "glossary:Vitalize", "name": "Vitalize", "category": "keyword", "source_type": "status (Stormbound Kitty rulebook glossary (https://stormbound-kitty.com/rulebook), supplement)", "edition": null, "faction": null, "subtypes": null, "rarity": null, "cost": null, "cost_num": null, "stats": null, "text": "A vitalized unit gains 1 strength at the start of each turn until it is poisoned.", "extra": null, "variants": null, "id": 1000044}
{"game": "stormbound", "ext_id": "glossary:Freeze", "name": "Freeze", "category": "keyword", "source_type": "status (Stormbound Kitty rulebook glossary (https://stormbound-kitty.com/rulebook), supplement)", "edition": null, "faction": null, "subtypes": null, "rarity": null, "cost": null, "cost_num": null, "stats": null, "text": "A frozen unit does not move at the start of its next turn and its ability is disabled for that turn; it lasts one turn.", "extra": null, "variants": null, "id": 1000045}
{"game": "stormbound", "ext_id": "glossary:Confuse", "name": "Confuse", "category": "keyword", "source_type": "status (Stormbound Kitty rulebook glossary (https://stormbound-kitty.com/rulebook), supplement)", "edition": null, "faction": null, "subtypes": null, "rarity": null, "cost": null, "cost_num": null, "stats": null, "text": "A confused unit moves sideways at random during its movement; it lasts one turn.", "extra": null, "variants": null, "id": 1000046}
{"game": "stormbound", "ext_id": "glossary:Disable", "name": "Disable", "category": "keyword", "source_type": "status (Stormbound Kitty rulebook glossary (https://stormbound-kitty.com/rulebook), supplement)", "edition": null, "faction": null, "subtypes": null, "rarity": null, "cost": null, "cost_num": null, "stats": null, "text": "A disabled unit loses its ability until it dies.", "extra": null, "variants": null, "id": 1000047}
{"game": "stormbound", "ext_id": "glossary:Command", "name": "Command", "category": "keyword", "source_type": "effect (Stormbound Kitty rulebook glossary (https://stormbound-kitty.com/rulebook), supplement)", "edition": null, "faction": null, "subtypes": null, "rarity": null, "cost": null, "cost_num": null, "stats": null, "text": "Forces a unit to move forward, ignoring its attack pattern and enemies on its sides.", "extra": null, "variants": null, "id": 1000048}
{"game": "stormbound", "ext_id": "glossary:Convert", "name": "Convert", "category": "keyword", "source_type": "effect (Stormbound Kitty rulebook glossary (https://stormbound-kitty.com/rulebook), supplement)", "edition": null, "faction": null, "subtypes": null, "rarity": null, "cost": null, "cost_num": null, "stats": null, "text": "Switches a unit to the other player's side.", "extra": null, "variants": null, "id": 1000049}
{"game": "stormbound", "ext_id": "glossary:Destroy", "name": "Destroy", "category": "keyword", "source_type": "effect (Stormbound Kitty rulebook glossary (https://stormbound-kitty.com/rulebook), supplement)", "edition": null, "faction": null, "subtypes": null, "rarity": null, "cost": null, "cost_num": null, "stats": null, "text": "Removes a target from the board whatever its strength.", "extra": null, "variants": null, "id": 1000050}
{"game": "stormbound", "ext_id": "glossary:Drain", "name": "Drain", "category": "keyword", "source_type": "effect (Stormbound Kitty rulebook glossary (https://stormbound-kitty.com/rulebook), supplement)", "edition": null, "faction": null, "subtypes": null, "rarity": null, "cost": null, "cost_num": null, "stats": null, "text": "Damages one unit and gives the same amount of health to another.", "extra": null, "variants": null, "id": 1000051}
{"game": "stormbound", "ext_id": "glossary:Force attack", "name": "Force attack", "category": "keyword", "source_type": "effect (Stormbound Kitty rulebook glossary (https://stormbound-kitty.com/rulebook), supplement)", "edition": null, "faction": null, "subtypes": null, "rarity": null, "cost": null, "cost_num": null, "stats": null, "text": "Makes a unit attack a bordering tile, usually at random; its before- and after-attacking abilities trigger.", "extra": null, "variants": null, "id": 1000052}
{"game": "stormbound", "ext_id": "glossary:Move fixedly forward", "name": "Move fixedly forward", "category": "keyword", "source_type": "effect (Stormbound Kitty rulebook glossary (https://stormbound-kitty.com/rulebook), supplement)", "edition": null, "faction": null, "subtypes": null, "rarity": null, "cost": null, "cost_num": null, "stats": null, "text": "Moves a unit forward while ignoring enemies on its sides.", "extra": null, "variants": null, "id": 1000053}
